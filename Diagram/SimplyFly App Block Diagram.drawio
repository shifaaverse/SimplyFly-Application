        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n%% ============================================================\n%% APPLICATION\n%% ============================================================\n\nAPP[\&quot;✈️ SIMPLYFLY — AIR TICKET BOOKING SYSTEM\&quot;]\n\n\n%% ============================================================\n%% THREE ACTOR COLUMNS\n%% ============================================================\n\nsubgraph ACTORS[\&quot; \&quot;]\ndirection LR\n\n\n%% ============================================================\n%% LEFT COLUMN — PASSENGER\n%% ============================================================\n\nsubgraph PASSENGER[\&quot;USER / PASSENGER\&quot;]\ndirection TB\n\nP1[\&quot;REGISTER&lt;br/&gt;Enter name, email, phone and password&lt;br/&gt;Validate details → Create account\&quot;]\n\nP2[\&quot;LOGIN&lt;br/&gt;Enter credentials&lt;br/&gt;Authenticate → Passenger Dashboard\&quot;]\n\nP3[\&quot;SEARCH FLIGHTS&lt;br/&gt;Select one-way / round-trip&lt;br/&gt;Enter origin → destination&lt;br/&gt;Journey date&lt;br/&gt;Return date if applicable\&quot;]\n\nP4[\&quot;SEND FLIGHT SEARCH REQUEST&lt;br/&gt;Request available flights from Airline\&quot;]\n\nP5[\&quot;RECEIVE AVAILABLE FLIGHTS&lt;br/&gt;Receive flight information from Airline\&quot;]\n\nP6[\&quot;VIEW FLIGHT RESULTS&lt;br/&gt;Airline → Flight Number&lt;br/&gt;Departure → Arrival&lt;br/&gt;Duration → Stops → Fare → Class → Baggage&lt;br/&gt;Rating → Seat Availability → Refundability\&quot;]\n\nP7[\&quot;FILTER FLIGHTS&lt;br/&gt;Price → Stops → Airline&lt;br/&gt;Departure → Arrival&lt;br/&gt;Duration → Class → Baggage&lt;br/&gt;Rating → Seat Availability → Refundability\&quot;]\n\nP8[\&quot;SORT FLIGHTS&lt;br/&gt;Recommended&lt;br/&gt;Price → Duration → Departure → Arrival&lt;br/&gt;Rating → Stops\&quot;]\n\nP9[\&quot;SELECT OUTBOUND FLIGHT&lt;br/&gt;Select preferred airline and flight&lt;br/&gt;Review schedule → Confirm outbound\&quot;]\n\nP10[\&quot;ROUND TRIP?&lt;br/&gt;YES → Search return flight → Filter → Sort → Select return&lt;br/&gt;NO → Continue\&quot;]\n\nP11[\&quot;ADD TRAVELLERS&lt;br/&gt;Name → DOB → Gender&lt;br/&gt;Government ID Type → Government ID Number\&quot;]\n\nP12[\&quot;AGE CALCULATION&lt;br/&gt;Calculate age from DOB&lt;br/&gt;Adult / Child / Infant&lt;br/&gt;Apply applicable fare\&quot;]\n\nP13[\&quot;SELECT CLASS&lt;br/&gt;View available classes&lt;br/&gt;Select cabin / class\&quot;]\n\nP14[\&quot;SELECT SEATS&lt;br/&gt;View seat map&lt;br/&gt;Select seat for each traveller&lt;br/&gt;Window / Middle / Aisle&lt;br/&gt;Apply seat fare\&quot;]\n\nP15[\&quot;FOOD&lt;br/&gt;View food options&lt;br/&gt;Select food&lt;br/&gt;Calculate price OR skip\&quot;]\n\nP16[\&quot;EXTRA BAGGAGE&lt;br/&gt;View included baggage&lt;br/&gt;Select extra baggage&lt;br/&gt;Calculate price OR continue\&quot;]\n\nP17[\&quot;FARE CALCULATION&lt;br/&gt;Outbound + Return Fare&lt;br/&gt;Passenger Category + Class + Seat&lt;br/&gt;Food + Baggage + Taxes&lt;br/&gt;Calculate Final Total\&quot;]\n\nP18[\&quot;REVIEW BOOKING&lt;br/&gt;Journey → Flights → Travellers&lt;br/&gt;Government IDs → Class → Seats&lt;br/&gt;Food → Baggage → Fare → Total\&quot;]\n\nP19[\&quot;SEND BOOKING REQUEST&lt;br/&gt;Send selected flight, passenger, seat,&lt;br/&gt;food, baggage and fare details to Airline\&quot;]\n\nP20[\&quot;PAYMENT&lt;br/&gt;Select payment method&lt;br/&gt;Card / UPI / Net Banking / Wallet&lt;br/&gt;Complete payment\&quot;]\n\nP21[\&quot;PAYMENT VERIFICATION&lt;br/&gt;Verify payment response&lt;br/&gt;Failed → Retry&lt;br/&gt;Successful → Continue\&quot;]\n\nP22[\&quot;RECEIVE BOOKING CONFIRMATION&lt;br/&gt;Receive PNR / Booking ID from Airline\&quot;]\n\nP23[\&quot;TICKET&lt;br/&gt;Generate e-ticket&lt;br/&gt;Create PDF&lt;br/&gt;Download ticket\&quot;]\n\nP24[\&quot;NOTIFICATIONS&lt;br/&gt;Booking confirmation&lt;br/&gt;Payment confirmation&lt;br/&gt;Ticket&lt;br/&gt;Flight updates&lt;br/&gt;Delay / Cancellation / Refund\&quot;]\n\nP25[\&quot;MY TRIPS&lt;br/&gt;Upcoming → Completed → Cancelled&lt;br/&gt;Flight status → Booking details → Ticket\&quot;]\n\nP26[\&quot;MANAGE BOOKING&lt;br/&gt;Search PNR / Booking ID&lt;br/&gt;View booking / ticket / flight status&lt;br/&gt;Add food / baggage\&quot;]\n\nP27[\&quot;RESCHEDULING REQUEST&lt;br/&gt;Select booking&lt;br/&gt;Select new date&lt;br/&gt;Request new flight\&quot;]\n\nP28[\&quot;RECEIVE RESCHEDULING OPTIONS&lt;br/&gt;Receive available flights, seats and fares\&quot;]\n\nP29[\&quot;CANCELLATION / REFUND REQUEST&lt;br/&gt;Select booking&lt;br/&gt;Check eligibility&lt;br/&gt;Submit cancellation / refund request\&quot;]\n\nP30[\&quot;RECEIVE REFUND RESULT&lt;br/&gt;Receive approved / rejected status&lt;br/&gt;Receive refund amount / status\&quot;]\n\nP31[\&quot;END PASSENGER WORKFLOW\&quot;]\n\n\nP1 --&gt; P2\nP2 --&gt; P3\nP3 --&gt; P4\nP4 --&gt; P5\nP5 --&gt; P6\nP6 --&gt; P7\nP7 --&gt; P8\nP8 --&gt; P9\nP9 --&gt; P10\nP10 --&gt; P11\nP11 --&gt; P12\nP12 --&gt; P13\nP13 --&gt; P14\nP14 --&gt; P15\nP15 --&gt; P16\nP16 --&gt; P17\nP17 --&gt; P18\nP18 --&gt; P19\nP19 --&gt; P20\nP20 --&gt; P21\nP21 --&gt; P22\nP22 --&gt; P23\nP23 --&gt; P24\nP24 --&gt; P25\nP25 --&gt; P26\nP26 --&gt; P27\nP27 --&gt; P28\nP28 --&gt; P29\nP29 --&gt; P30\nP30 --&gt; P31\n\nend\n\n\n%% ============================================================\n%% CENTER COLUMN — AIRLINE\n%% ============================================================\n\nsubgraph AIRLINE[\&quot;AIRLINE\&quot;]\ndirection TB\n\nA1[\&quot;AIRLINE ONBOARDING&lt;br/&gt;Admin enters airline details&lt;br/&gt;Verify information&lt;br/&gt;Approve airline&lt;br/&gt;Activate airline account\&quot;]\n\nA2[\&quot;LOGIN&lt;br/&gt;Enter airline credentials&lt;br/&gt;Authenticate → Airline Dashboard\&quot;]\n\nA3[\&quot;MANAGE ROUTES&lt;br/&gt;Add route&lt;br/&gt;Origin → Destination&lt;br/&gt;View → Edit → Remove\&quot;]\n\nA4[\&quot;CREATE FLIGHT&lt;br/&gt;Select route&lt;br/&gt;Flight number / name&lt;br/&gt;Journey date&lt;br/&gt;Departure / Arrival&lt;br/&gt;Aircraft details\&quot;]\n\nA5[\&quot;MANAGE SCHEDULE&lt;br/&gt;Journey dates&lt;br/&gt;Departure / Arrival times&lt;br/&gt;Frequency&lt;br/&gt;Update schedule\&quot;]\n\nA6[\&quot;CONFIGURE CLASS&lt;br/&gt;Available class&lt;br/&gt;Class fare&lt;br/&gt;Seat capacity&lt;br/&gt;Included baggage&lt;br/&gt;Available services\&quot;]\n\nA7[\&quot;CONFIGURE SEATS&lt;br/&gt;Seat map&lt;br/&gt;Seat numbers&lt;br/&gt;Window / Middle / Aisle&lt;br/&gt;Assign class&lt;br/&gt;Seat availability&lt;br/&gt;Seat-specific fare\&quot;]\n\nA8[\&quot;MANAGE FARES&lt;br/&gt;Base fare&lt;br/&gt;Class fare&lt;br/&gt;Seat-specific fare&lt;br/&gt;Update pricing\&quot;]\n\nA9[\&quot;MANAGE BAGGAGE&lt;br/&gt;Included baggage&lt;br/&gt;Extra baggage options&lt;br/&gt;Weight → Price\&quot;]\n\nA10[\&quot;MANAGE FOOD&lt;br/&gt;Food options&lt;br/&gt;Description → Price&lt;br/&gt;Availability\&quot;]\n\nA11[\&quot;PUBLISH FLIGHT&lt;br/&gt;Validate route&lt;br/&gt;Validate schedule&lt;br/&gt;Validate class&lt;br/&gt;Validate seats&lt;br/&gt;Validate fares&lt;br/&gt;Validate baggage&lt;br/&gt;Validate food&lt;br/&gt;Publish for passenger search\&quot;]\n\nA12[\&quot;RECEIVE FLIGHT SEARCH REQUEST&lt;br/&gt;Receive search criteria from Passenger\&quot;]\n\nA13[\&quot;SEND AVAILABLE FLIGHTS&lt;br/&gt;Return matching flights&lt;br/&gt;Schedules → Fares → Seats → Availability\&quot;]\n\nA14[\&quot;RECEIVE BOOKING REQUEST&lt;br/&gt;Receive passenger, flight, seat,&lt;br/&gt;food, baggage and payment information\&quot;]\n\nA15[\&quot;MANAGE BOOKING&lt;br/&gt;Validate PNR&lt;br/&gt;Passenger / Traveller details&lt;br/&gt;Government ID&lt;br/&gt;Seats → Class → Food → Baggage&lt;br/&gt;Payment → Booking status\&quot;]\n\nA16[\&quot;CONFIRM BOOKING&lt;br/&gt;Reserve seats&lt;br/&gt;Generate PNR / Booking ID&lt;br/&gt;Update booking status\&quot;]\n\nA17[\&quot;SEND BOOKING CONFIRMATION&lt;br/&gt;Send PNR / ticket information to Passenger\&quot;]\n\nA18[\&quot;MANAGE SEAT AVAILABILITY&lt;br/&gt;Total seats&lt;br/&gt;Booked seats&lt;br/&gt;Available seats&lt;br/&gt;Update after booking / cancellation / rescheduling\&quot;]\n\nA19[\&quot;UPDATE FLIGHT STATUS&lt;br/&gt;Scheduled&lt;br/&gt;On-time&lt;br/&gt;Delayed&lt;br/&gt;Cancelled\&quot;]\n\nA20[\&quot;SEND FLIGHT NOTIFICATION&lt;br/&gt;Schedule changes&lt;br/&gt;Delay&lt;br/&gt;Cancellation&lt;br/&gt;Other flight updates\&quot;]\n\nA21[\&quot;RECEIVE RESCHEDULING REQUEST&lt;br/&gt;Receive request from Passenger\&quot;]\n\nA22[\&quot;CHECK RESCHEDULING&lt;br/&gt;Available dates&lt;br/&gt;Available flights&lt;br/&gt;Available seats&lt;br/&gt;Applicable fares\&quot;]\n\nA23[\&quot;SEND RESCHEDULING OPTIONS&lt;br/&gt;Return flights → seats → fares\&quot;]\n\nA24[\&quot;RECEIVE CANCELLATION / REFUND REQUEST&lt;br/&gt;Receive request forwarded by Admin\&quot;]\n\nA25[\&quot;PROCESS CANCELLATION / REFUND&lt;br/&gt;Review booking&lt;br/&gt;Check cancellation rules&lt;br/&gt;Check refund eligibility\&quot;]\n\nA26[\&quot;DECISION&lt;br/&gt;APPROVED or REJECTED\&quot;]\n\nA27[\&quot;IF APPROVED&lt;br/&gt;Approve cancellation&lt;br/&gt;Calculate refund&lt;br/&gt;Process refund&lt;br/&gt;Update refund status\&quot;]\n\nA28[\&quot;IF REJECTED&lt;br/&gt;Record rejection reason&lt;br/&gt;Update request status\&quot;]\n\nA29[\&quot;SEND DECISION TO ADMIN&lt;br/&gt;Send approval / rejection&lt;br/&gt;Send refund information\&quot;]\n\nA30[\&quot;SUPPORT WEB CHECK-IN&lt;br/&gt;Validate booking&lt;br/&gt;Validate passenger&lt;br/&gt;Verify eligibility&lt;br/&gt;Check check-in window&lt;br/&gt;Provide boarding-pass information\&quot;]\n\nA31[\&quot;END AIRLINE WORKFLOW\&quot;]\n\n\nA1 --&gt; A2\nA2 --&gt; A3\nA3 --&gt; A4\nA4 --&gt; A5\nA5 --&gt; A6\nA6 --&gt; A7\nA7 --&gt; A8\nA8 --&gt; A9\nA9 --&gt; A10\nA10 --&gt; A11\nA11 --&gt; A12\nA12 --&gt; A13\nA13 --&gt; A14\nA14 --&gt; A15\nA15 --&gt; A16\nA16 --&gt; A17\nA17 --&gt; A18\nA18 --&gt; A19\nA19 --&gt; A20\nA20 --&gt; A21\nA21 --&gt; A22\nA22 --&gt; A23\nA23 --&gt; A24\nA24 --&gt; A25\nA25 --&gt; A26\nA26 --&gt; A27\nA27 --&gt; A28\nA28 --&gt; A29\nA29 --&gt; A30\nA30 --&gt; A31\n\nend\n\n\n%% ============================================================\n%% RIGHT COLUMN — ADMIN\n%% ============================================================\n\nsubgraph ADMIN[\&quot;ADMIN\&quot;]\ndirection TB\n\nD1[\&quot;LOGIN&lt;br/&gt;Enter admin credentials&lt;br/&gt;Authenticate → Admin Dashboard\&quot;]\n\nD2[\&quot;ADMIN DASHBOARD&lt;br/&gt;Airlines → Passengers → Flights&lt;br/&gt;Bookings → Revenue&lt;br/&gt;Cancellation / Refund Requests → Reports\&quot;]\n\nD3[\&quot;AIRLINE ONBOARDING&lt;br/&gt;Receive airline details&lt;br/&gt;Verify registration / documents&lt;br/&gt;Approve / Reject airline&lt;br/&gt;Activate airline account\&quot;]\n\nD4[\&quot;MANAGE AIRLINES&lt;br/&gt;View airlines&lt;br/&gt;View airline details&lt;br/&gt;Update information&lt;br/&gt;Activate / Deactivate airline\&quot;]\n\nD5[\&quot;MANAGE PASSENGERS&lt;br/&gt;View passenger accounts&lt;br/&gt;View passenger details&lt;br/&gt;View booking history\&quot;]\n\nD6[\&quot;MONITOR ROUTES&lt;br/&gt;View airline routes&lt;br/&gt;Origin → Destination&lt;br/&gt;Monitor route information\&quot;]\n\nD7[\&quot;MONITOR FLIGHTS&lt;br/&gt;Airline → Flight Number&lt;br/&gt;Route → Schedule → Status&lt;br/&gt;Seat Capacity → Available Seats → Bookings\&quot;]\n\nD8[\&quot;MANAGE BOOKINGS&lt;br/&gt;Booking ID / PNR&lt;br/&gt;Passenger → Airline → Flight → Date&lt;br/&gt;Payment Status → Booking Status\&quot;]\n\nD9[\&quot;RECEIVE CANCELLATION / REFUND REQUEST&lt;br/&gt;Receive request from Passenger&lt;br/&gt;Identify booking&lt;br/&gt;Verify passenger and payment details\&quot;]\n\nD10[\&quot;VALIDATE REQUEST&lt;br/&gt;Check booking&lt;br/&gt;Check payment&lt;br/&gt;Check cancellation conditions&lt;br/&gt;Check refund eligibility\&quot;]\n\nD11[\&quot;FORWARD REQUEST TO AIRLINE&lt;br/&gt;Send cancellation / refund request&lt;br/&gt;Include booking information&lt;br/&gt;Track request\&quot;]\n\nD12[\&quot;RECEIVE AIRLINE DECISION&lt;br/&gt;Receive approved / rejected status&lt;br/&gt;Review airline remarks&lt;br/&gt;Update request status\&quot;]\n\nD13[\&quot;IF REJECTED&lt;br/&gt;Record rejection&lt;br/&gt;Update request status&lt;br/&gt;Notify Passenger\&quot;]\n\nD14[\&quot;IF APPROVED&lt;br/&gt;Monitor cancellation&lt;br/&gt;Monitor refund processing&lt;br/&gt;Update refund status&lt;br/&gt;Notify Passenger\&quot;]\n\nD15[\&quot;REPORTS &amp; ANALYTICS&lt;br/&gt;Booking&lt;br/&gt;Revenue&lt;br/&gt;Passenger&lt;br/&gt;Airline&lt;br/&gt;Flight&lt;br/&gt;Cancellation&lt;br/&gt;Refund\&quot;]\n\nD16[\&quot;NOTIFICATION MONITORING&lt;br/&gt;Booking&lt;br/&gt;Payment&lt;br/&gt;Ticket&lt;br/&gt;Flight status&lt;br/&gt;Cancellation&lt;br/&gt;Refund\&quot;]\n\nD17[\&quot;LOGOUT&lt;br/&gt;End Admin Session\&quot;]\n\nD18[\&quot;END ADMIN WORKFLOW\&quot;]\n\n\nD1 --&gt; D2\nD2 --&gt; D3\nD3 --&gt; D4\nD4 --&gt; D5\nD5 --&gt; D6\nD6 --&gt; D7\nD7 --&gt; D8\nD8 --&gt; D9\nD9 --&gt; D10\nD10 --&gt; D11\nD11 --&gt; D12\nD12 --&gt; D13\nD13 --&gt; D14\nD14 --&gt; D15\nD15 --&gt; D16\nD16 --&gt; D17\nD17 --&gt; D18\n\nend\n\n\n%% ============================================================\n%% ACTOR RELATIONSHIP — REPRESENTED VERTICALLY\n%% ============================================================\n\n%% Passenger communicates with Airline\n%% The communication is explicitly written inside each\n%% actor&#39;s vertical workflow so NO horizontal arrows are used.\n\n%% Airline communicates with Admin\n%% Admin communicates with Passenger\n\n%% ============================================================\n%% CLEAN STYLE — NO COLORS\n%% ============================================================\n\nclassDef clean fill:#FFFFFF,stroke:#333333,stroke-width:1px,color:#111111;\n\nclass P1,P2,P3,P4,P5,P6,P7,P8,P9,P10,P11,P12,P13,P14,P15,P16,P17,P18,P19,P20,P21,P22,P23,P24,P25,P26,P27,P28,P29,P30,P31 clean;\n\nclass A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12,A13,A14,A15,A16,A17,A18,A19,A20,A21,A22,A23,A24,A25,A26,A27,A28,A29,A30,A31 clean;\n\nclass D1,D2,D3,D4,D5,D6,D7,D8,D9,D10,D11,D12,D13,D14,D15,D16,D17,D18 clean;\n\nstyle APP fill:#FFFFFF,stroke:#222222,stroke-width:2px,color:#111111&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="SkPADsE6_YKJa1JJ7YUe-1">
